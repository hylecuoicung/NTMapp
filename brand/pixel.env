# Pixel Digital: the second brand. Same software and the same logo as NTM Digital, under another
# name, with its own installers, install folders, registry keys and release tags, so both can be
# installed side by side and neither is offered the other's updates. Read by brand/build.rs,
# brand/brand.ps1 and the tests in brand/src/lib.rs. See README.md before editing.
#
# NEVER change a *_UPGRADE_CODE or *_COMPONENT_GUID once a build with it has been released.
ID=pixel
COMPANY=Pixel Digital
SLUG=pixeldigital
VENDOR_DIR=PixelDigital
REPO=hylecuoicung/NTMapp
# Release tags are <app>-<TAG_INFIX>v<version>: editor-pixel-v0.20.2 for this brand.
TAG_INFIX=pixel-
# Community links shown in Help, About and Home. Empty URL = no link.
DISCORD_URL=
DISCORD_LABEL=
WEBSITE_URL=https://pixeldigital.vn
WEBSITE_LABEL=pixeldigital.vn Website
FACEBOOK_URL=https://www.facebook.com/pixeldigitalvn
FACEBOOK_LABEL=Pixel Digital on Facebook
# Pixel Digital Editor
EDITOR_PRODUCT=Pixel Digital Editor
EDITOR_EXE=pixeldigital-editor
EDITOR_FOLDER=PixelDigitalEditor
EDITOR_UPGRADE_CODE=F746F4EC-FD39-4ED2-B3D8-681CEBDC757B
EDITOR_COMPONENT_GUID=B55723D9-0F08-4823-AAE6-56856E95C951
# Pixel Digital Photo
PHOTO_PRODUCT=Pixel Digital Photo
PHOTO_EXE=pixeldigital-photo
PHOTO_FOLDER=PixelDigitalPhoto
PHOTO_UPGRADE_CODE=DFFB04B3-D200-4830-B1D6-8F78A4B1227D
PHOTO_COMPONENT_GUID=3FB0BE04-BB64-456B-A56F-BB9344E0C929
