# NTM Digital: the brand every build carries unless NTM_BRAND says otherwise, and the one whose
# names the sources spell. Read by brand/build.rs (the apps), brand/brand.ps1 (installers and
# workflows) and the tests in brand/src/lib.rs. See README.md before editing.
#
# NEVER change a *_UPGRADE_CODE or *_COMPONENT_GUID once a build with it has been released: an
# installer with another UpgradeCode no longer updates the copy people have.
ID=ntm
COMPANY=NTM Digital
SLUG=ntmdigital
VENDOR_DIR=NTMDigital
REPO=hylecuoicung/NTMapp
# Release tags are <app>-<TAG_INFIX>v<version>: editor-v0.20.2 for this brand.
TAG_INFIX=
# Community links shown in Help, About and Home. Empty URL = no link.
DISCORD_URL=https://discord.com/channels/1004088367216070770/1004088367824248976
DISCORD_LABEL=Join the NTM Discord…
WEBSITE_URL=
WEBSITE_LABEL=
FACEBOOK_URL=
FACEBOOK_LABEL=
# NTM Digital Editor
EDITOR_PRODUCT=NTM Digital Editor
EDITOR_EXE=ntmdigital-editor
EDITOR_FOLDER=NTMDigitalEditor
EDITOR_UPGRADE_CODE=BB5F6996-DF46-4CB3-9742-12A7CE95C4F6
EDITOR_COMPONENT_GUID=E229F7E2-2C3A-4508-989E-1A1250F3C81D
# NTM Digital Photo
PHOTO_PRODUCT=NTM Digital Photo
PHOTO_EXE=ntmdigital-photo
PHOTO_FOLDER=NTMDigitalPhoto
PHOTO_UPGRADE_CODE=5C704DD5-97D3-444B-8773-212A037E822B
PHOTO_COMPONENT_GUID=6344F377-2A6C-4596-B8CA-805F4D6EA367
